<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="bankGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6" />
      <stop offset="100%" stop-color="#1D4ED8" />
    </linearGradient>
    <linearGradient id="roofGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563EB" />
      <stop offset="100%" stop-color="#1E40AF" />
    </linearGradient>
    <filter id="bShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#1E3A8A" flood-opacity="0.25"/>
    </filter>
  </defs>
  <!-- Background Circle -->
  <circle cx="50" cy="50" r="44" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="2" filter="url(#bShadow)"/>
  <!-- Bank Roof -->
  <path d="M 18 38 L 50 18 L 82 38 Z" fill="url(#roofGrad)" stroke="#1E3A8A" stroke-width="2" stroke-linejoin="round"/>
  <!-- Arch/Pediment detail -->
  <rect x="22" y="38" width="56" height="5" fill="#1E40AF" rx="1"/>
  <!-- Columns -->
  <rect x="26" y="45" width="8" height="26" fill="url(#bankGrad)" rx="1"/>
  <rect x="40" y="45" width="8" height="26" fill="url(#bankGrad)" rx="1"/>
  <rect x="54" y="45" width="8" height="26" fill="url(#bankGrad)" rx="1"/>
  <rect x="68" y="45" width="8" height="26" fill="url(#bankGrad)" rx="1"/>
  <!-- Base -->
  <rect x="20" y="71" width="60" height="6" fill="#1E40AF" rx="2"/>
  <rect x="16" y="77" width="68" height="5" fill="#1E3A8A" rx="2"/>
</svg>
